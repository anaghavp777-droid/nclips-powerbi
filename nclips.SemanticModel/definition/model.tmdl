model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Calendar_Table","Payments_Table","Quiz_Results_Table","Students_Table","Calculated_Table","Calculated_Table (2)"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table Calendar_Table
ref table Payments_Table
ref table Quiz_Results_Table
ref table Students_Table
ref table 'Calculated_Table (2)'
ref table 'Top Rank'

ref cultureInfo en-US

